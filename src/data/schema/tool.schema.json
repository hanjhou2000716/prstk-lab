{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prstk-lab.github.io/schema/tool.schema.json",
  "title": "PRStK Lab Tool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "brandName",
    "summary",
    "description",
    "categories",
    "useCases",
    "markets",
    "assetClasses",
    "analysisTypes",
    "pricing",
    "requiresLogin",
    "language",
    "mobileSupport",
    "dataSources",
    "updateFrequency",
    "status",
    "lastVerifiedAt",
    "verifiedBy",
    "features",
    "limitations",
    "targetUsers",
    "tags",
    "aliases",
    "url",
    "screenshots",
    "relatedTools",
    "relatedResearch",
    "riskNotice",
    "featured"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "brandName": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "useCases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "markets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "assetClasses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "analysisTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "pricing": { "type": "string", "enum": ["free", "freemium", "paid", "unknown"] },
    "requiresLogin": { "type": "string", "enum": ["yes", "no", "unknown"] },
    "language": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "mobileSupport": { "type": "string", "enum": ["yes", "no", "unknown"] },
    "dataSources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "updateFrequency": { "type": "string", "enum": ["realtime", "daily", "weekly", "monthly", "irregular", "unknown"] },
    "status": { "type": "string", "enum": ["verified", "pending-verification", "unavailable", "stopped", "beta", "unknown"] },
    "lastVerifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verifiedBy": { "type": "string", "minLength": 1 },
    "features": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "targetUsers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "url": { "type": "string", "format": "uri" },
    "screenshots": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedTools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedResearch": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "riskNotice": { "type": "string", "minLength": 1 },
    "featured": { "type": "boolean" }
  }
}
