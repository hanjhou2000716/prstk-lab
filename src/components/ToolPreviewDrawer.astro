---
import ToolDetail from './ToolDetail.astro';
---
<div id="drawer-overlay" aria-hidden="true" class="fixed inset-0 bg-muji-text/30 backdrop-blur-[2px] z-[70] hidden opacity-0 transition-opacity duration-400"></div>
<div id="info-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true" tabindex="-1" class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white rounded-t-[28px] shadow-[0_-12px_40px_rgba(74,96,109,0.15)] z-[80] transform translate-y-full drawer-transition border-t border-muji-border max-h-[85vh] flex flex-col">
  <button type="button" data-drawer-close aria-label="關閉詳細資訊" class="flex-shrink-0 pt-3.5 pb-1 cursor-pointer flex justify-center w-full">
    <div class="w-12 h-1.5 bg-muji-border/80 rounded-full hover:bg-muji-brand/40 transition-colors"></div>
  </button>
  <div class="px-7 pb-8 pt-2 overflow-y-auto flex-1 custom-scrollbar">
    <div class="flex justify-between items-start mb-6">
      <div class="pr-4">
        <h3 id="drawer-title" class="text-[19px] font-semibold tracking-wider text-muji-text">標題</h3>
        <p id="drawer-subtitle" class="text-[11px] text-muji-brand mt-1.5 tracking-widest font-medium bg-muji-brandLight inline-block px-2.5 py-0.5 rounded-md"></p>
      </div>
      <button type="button" data-drawer-close aria-label="關閉詳細資訊" class="p-2 rounded-full hover:bg-muji-bg text-muji-muted hover:text-muji-brand transition-all flex-shrink-0 active:scale-95 bg-white shadow-sm border border-muji-border/30">
        <i data-lucide="x" class="w-4.5 h-4.5"></i>
      </button>
    </div>
    <ToolDetail />
    <div class="mt-8 pt-1">
      <a id="drawer-link" href="#" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="group flex items-center justify-center gap-2.5 w-full py-4 bg-muji-brand hover:bg-[#384a54] text-white text-[13.5px] font-medium tracking-widest rounded-xl transition-all duration-300 shadow-[0_4px_15px_rgba(74,96,109,0.2)] hover:shadow-[0_6px_20px_rgba(74,96,109,0.3)] hover:-translate-y-0.5 active:scale-[0.98]">
        <span>開啟系統</span>
        <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1.5 transition-transform"></i>
      </a>
    </div>
  </div>
</div>
