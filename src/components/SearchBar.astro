<section id="tool-search-panel" class="rounded-3xl border border-muji-border/80 bg-white/80 p-4 sm:p-5 shadow-sm backdrop-blur-sm" aria-label="工具搜尋與篩選" data-aos="fade-up">
  <div class="flex flex-row gap-2 items-center">
    <label class="relative block flex-1">
      <span class="sr-only">搜尋工具</span>
      <i data-lucide="search" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-muji-muted h-4 w-4"></i>
      <input id="tool-search" type="search" autocomplete="off" placeholder="搜尋工具、功能或適合對象" class="w-full rounded-xl border border-muji-border bg-muji-bg/70 py-3 pl-10 pr-4 text-sm text-muji-text placeholder:text-muji-muted/60 transition focus:border-muji-brand focus:bg-white focus:outline-none" />
    </label>
    <button id="favorites-filter" type="button" aria-label="只顯示我的最愛" title="我的最愛" aria-pressed="false" class="filter-chip inline-flex shrink-0 items-center justify-center rounded-xl border border-muji-border bg-white px-3 py-3 text-xs font-medium text-muji-brand transition hover:border-orange hover:text-orange">
      <i data-lucide="heart" class="h-4 w-4"></i>
    </button>
  </div>
  <div id="category-filters" class="mt-4 flex gap-2 overflow-x-auto pb-1" aria-label="工具分類"></div>
  <div class="mt-3 flex items-center justify-between gap-2">
    <button id="advanced-filter-toggle" type="button" aria-expanded="false" aria-controls="advanced-filters" class="inline-flex items-center gap-1.5 rounded-full border border-muji-border bg-white px-3 py-2 text-[11px] font-medium text-muji-brand transition hover:border-muji-brand hover:bg-muji-brand/5">
      <i data-lucide="sliders-horizontal" class="h-3.5 w-3.5"></i>
      進階篩選
    </button>
    <button id="filter-reset" type="button" class="hidden text-[11px] font-medium text-muji-muted underline-offset-2 hover:text-orange hover:underline">清除篩選</button>
  </div>
  <div id="advanced-filters" hidden class="mt-3 grid grid-cols-2 gap-2 rounded-2xl border border-muji-border/70 bg-muji-bg/55 p-3 sm:grid-cols-4">
    <label class="flex flex-col gap-1 text-[10px] text-muji-muted">
      價格
      <select data-facet="pricing" class="rounded-xl border border-muji-border bg-white px-2.5 py-2 text-xs text-muji-text focus:border-muji-brand focus:outline-none">
        <option value="">不限</option><option value="free">免費</option><option value="paid">付費</option><option value="freemium">免費增值</option><option value="unknown">尚未驗證</option>
      </select>
    </label>
    <label class="flex flex-col gap-1 text-[10px] text-muji-muted">
      服務狀態
      <select data-facet="status" class="rounded-xl border border-muji-border bg-white px-2.5 py-2 text-xs text-muji-text focus:border-muji-brand focus:outline-none">
        <option value="">不限</option><option value="verified">已驗證</option><option value="pending-verification">待驗證</option><option value="beta">Beta</option><option value="temporarily-unavailable">暫時無法使用</option>
      </select>
    </label>
    <label class="flex flex-col gap-1 text-[10px] text-muji-muted">
      登入要求
      <select data-facet="requiresLogin" class="rounded-xl border border-muji-border bg-white px-2.5 py-2 text-xs text-muji-text focus:border-muji-brand focus:outline-none">
        <option value="">不限</option><option value="no">免登入</option><option value="yes">需登入</option><option value="unknown">尚未驗證</option>
      </select>
    </label>
    <label class="flex flex-col gap-1 text-[10px] text-muji-muted">
      行動支援
      <select data-facet="mobileSupport" class="rounded-xl border border-muji-border bg-white px-2.5 py-2 text-xs text-muji-text focus:border-muji-brand focus:outline-none">
        <option value="">不限</option><option value="yes">支援手機</option><option value="no">不支援手機</option><option value="unknown">尚未驗證</option>
      </select>
    </label>
  </div>
  <div class="mt-3 flex items-center justify-between gap-3">
    <p id="tool-result-summary" class="text-xs text-muji-muted" aria-live="polite"></p>
    <button id="view-all-tools" type="button" class="hidden text-xs font-medium text-muji-brand hover:text-orange">查看全部</button>
  </div>
</section>
