<section id="scenario-entries" aria-label="投資情境快捷入口" data-aos="fade-up" data-aos-delay="80">
  <div class="grid grid-cols-4 gap-2">
    <button type="button" data-scenario-category="explore" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
      <i data-lucide="sparkles" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
      <span class="text-xs font-medium tracking-wide text-muji-text">找機會</span>
    </button>
    <button type="button" data-scenario-category="research" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
      <i data-lucide="search-check" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
      <span class="text-xs font-medium tracking-wide text-muji-text">做研究</span>
    </button>
    <button type="button" data-scenario-category="risk" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
      <i data-lucide="shield-alert" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
      <span class="text-xs font-medium tracking-wide text-muji-text">看風險</span>
    </button>
    <button type="button" data-scenario-category="allocation" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
      <i data-lucide="landmark" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
      <span class="text-xs font-medium tracking-wide text-muji-text">做配置</span>
    </button>
  </div>
</section>
