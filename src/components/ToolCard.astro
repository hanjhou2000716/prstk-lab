---
import FavoriteButton from './FavoriteButton.astro';
import PinButton from './PinButton.astro';
import CompareButton from './CompareButton.astro';
---
<template id="tool-card-template">
  <div class="relative group h-full">
    <a data-tool-link target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="flex flex-col justify-center w-full h-full min-h-[76px] py-4 pl-3.5 pr-9 bg-white border border-muji-border/80 rounded-2xl shadow-sm card-hover-effect">
      <span data-tool-name class="text-[13px] font-medium tracking-wide text-muji-text group-hover:text-muji-brand transition-colors leading-tight truncate"></span>
      <span data-tool-brand class="text-[10px] text-muji-muted/80 tracking-wider mt-1.5 font-light block truncate"></span>
      <span data-tool-status class="mt-1 inline-flex w-fit items-center rounded-full bg-sage/10 px-1.5 py-0.5 text-[9px] font-medium tracking-wide text-muji-brand"></span>
    </a>
    <button type="button" data-tool-action="info" class="tool-action info-action" aria-label="查看詳細資訊" aria-expanded="false">
      <i data-lucide="info" class="w-4 h-4 text-muji-muted/50 hover:text-muji-brand transition-colors"></i>
    </button>
    <FavoriteButton />
    <PinButton />
    <CompareButton />
  </div>
</template>
