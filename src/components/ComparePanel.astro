<div id="compare-bar" class="fixed bottom-4 left-1/2 z-[55] hidden w-[min(92vw,42rem)] -translate-x-1/2 rounded-2xl border border-muji-border/80 bg-white/95 px-4 py-3 shadow-[0_10px_35px_rgba(31,53,70,0.18)] backdrop-blur-sm" aria-live="polite">
  <div class="flex items-center justify-between gap-3">
    <p id="compare-summary" class="text-xs text-muji-text">已選 0 / 3 個工具</p>
    <div class="flex items-center gap-2">
      <button id="clear-compare" type="button" class="rounded-full px-3 py-2 text-[11px] text-muji-muted hover:bg-muji-bg hover:text-orange">清除</button>
      <button id="open-compare" type="button" class="rounded-full bg-muji-brand px-4 py-2 text-[11px] font-medium text-white transition hover:bg-[#384a54] disabled:cursor-not-allowed disabled:opacity-50" disabled>比較工具</button>
    </div>
  </div>
</div>
<section id="compare-panel" role="dialog" aria-modal="true" aria-labelledby="compare-title" aria-hidden="true" class="fixed inset-0 z-[75] hidden bg-muji-bg/95 px-5 py-6 backdrop-blur-sm">
  <div class="mx-auto flex h-full max-w-5xl flex-col">
    <div class="mb-4 flex items-center justify-between">
      <div><p class="text-[10px] tracking-[0.15em] text-muji-muted">PRStK LAB</p><h2 id="compare-title" class="mt-1 text-lg font-semibold text-muji-text">工具比較</h2></div>
      <button id="close-compare" type="button" aria-label="關閉比較" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-muji-border bg-white text-muji-brand hover:border-orange hover:text-orange"><i data-lucide="x" class="h-4 w-4"></i></button>
    </div>
    <div id="compare-grid" class="grid flex-1 auto-rows-min gap-3 overflow-y-auto pb-6"></div>
  </div>
</section>
