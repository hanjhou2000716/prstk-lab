---
import research from '../../data/research.json';
const siteUrl = 'https://hanjhou2000716.github.io/prstk-lab/';
---
<!doctype html><html lang="zh-TW"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="PRStK Lab 研究內容與方法論。"><link rel="canonical" href={`${siteUrl}research/`}><title>研究｜PRStK Lab</title><link rel="stylesheet" href="../assets/styles.css"></head>
<body class="min-h-screen bg-muji-bg text-muji-text"><main class="mx-auto max-w-4xl px-5 py-10 sm:px-8"><a href="../" class="text-sm text-muji-brand hover:text-orange">← 回到首頁</a><header class="mt-10"><p class="text-xs tracking-[0.2em] text-muji-muted">PRSTK LAB · RESEARCH</p><h1 class="mt-2 text-3xl font-semibold">研究內容</h1><p class="mt-3 max-w-2xl text-sm leading-7 text-muji-muted">每篇研究都標記問題、方法、來源與風險，讓結論可以被檢查與持續更新。</p></header><div class="mt-8 grid gap-4 sm:grid-cols-2">{research.map(article => <a href={`./${article.slug}/`} class="rounded-2xl border border-muji-border bg-white/85 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-muji-brand"><span class="text-[11px] font-medium text-muji-brand">{article.type}</span><h2 class="mt-2 text-lg font-semibold">{article.title}</h2><p class="mt-2 text-sm leading-6 text-muji-muted">{article.summary}</p><p class="mt-4 text-[11px] text-muji-muted">更新於 {article.updatedAt}</p></a>)}</div></main></body></html>
