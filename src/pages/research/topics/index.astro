---
import topics from '../../../data/research-topics.json';
const siteUrl = 'https://hanjhou2000716.github.io/prstk-lab/';
---
<!doctype html><html lang="zh-TW"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="PRStK Lab 研究專題集合。"><link rel="canonical" href={`${siteUrl}research/topics/`}><title>研究專題｜PRStK Lab</title><link rel="stylesheet" href="../../assets/styles.css"></head><body class="min-h-screen bg-muji-bg text-muji-text"><main class="mx-auto max-w-4xl px-5 py-10 sm:px-8"><a href="../../" class="text-sm text-muji-brand hover:text-orange">← 研究首頁</a><h1 class="mt-10 text-3xl font-semibold">研究專題</h1><div class="mt-8 grid gap-4 sm:grid-cols-2">{topics.map(topic => <article class="rounded-2xl border border-muji-border bg-white/85 p-5 shadow-sm"><h2 class="text-lg font-semibold">{topic.title}</h2><p class="mt-2 text-sm leading-6 text-muji-muted">{topic.summary}</p><div class="mt-4 flex flex-wrap gap-2">{topic.methods.map(method => <span class="rounded-full bg-muji-brandLight px-2.5 py-1 text-[10px] text-muji-brand">{method}</span>)}</div><p class="mt-4 text-xs text-muji-muted">關聯工具 {topic.tools.length} 個 · 研究內容 {topic.research.length} 篇</p></article>)}</div></main></body></html>
