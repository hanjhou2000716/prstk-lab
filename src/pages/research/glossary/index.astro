---
import glossary from '../../../data/glossary.json';
const siteUrl = 'https://hanjhou2000716.github.io/prstk-lab/';
---
<!doctype html><html lang="zh-TW"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="PRStK Lab 投資研究方法論與名詞庫。"><link rel="canonical" href={`${siteUrl}research/glossary/`}><title>方法論詞庫｜PRStK Lab</title><link rel="stylesheet" href="../../assets/styles.css"></head><body class="min-h-screen bg-muji-bg text-muji-text"><main class="mx-auto max-w-4xl px-5 py-10 sm:px-8"><a href="../../" class="text-sm text-muji-brand hover:text-orange">← 研究首頁</a><h1 class="mt-10 text-3xl font-semibold">方法論詞庫</h1><p class="mt-3 text-sm leading-7 text-muji-muted">用一致定義閱讀研究內容；實際計算仍需確認資料來源、期間與假設。</p><div class="mt-8 space-y-3">{glossary.map(item => <article class="rounded-2xl border border-muji-border bg-white/85 p-5"><div class="flex flex-wrap items-baseline gap-2"><h2 class="text-lg font-semibold">{item.term}</h2><span class="text-xs text-muji-muted">{item.name}</span></div><p class="mt-2 text-sm leading-7">{item.definition}</p><div class="mt-3 flex flex-wrap gap-2">{item.related.map(term => <span class="rounded-full bg-muji-bg px-2.5 py-1 text-[10px] text-muji-muted">相關：{term}</span>)}</div></article>)}</div></main></body></html>
