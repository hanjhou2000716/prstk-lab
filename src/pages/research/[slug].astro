---
import research from '../../data/research.json';
export function getStaticPaths() { return research.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
const siteUrl = 'https://hanjhou2000716.github.io/prstk-lab/';
---
<!doctype html><html lang="zh-TW"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content={article.summary}><link rel="canonical" href={`${siteUrl}research/${article.slug}/`}><title>{article.title}｜PRStK Lab</title><link rel="stylesheet" href="../../assets/styles.css"></head>
<body class="min-h-screen bg-muji-bg text-muji-text"><main class="mx-auto max-w-3xl px-5 py-10 sm:px-8"><a href="../" class="text-sm text-muji-brand hover:text-orange">← 所有研究</a><article class="mt-10"><p class="text-xs tracking-[0.2em] text-muji-muted">{article.type} · {article.updatedAt}</p><h1 class="mt-2 text-3xl font-semibold leading-tight">{article.title}</h1><p class="mt-4 text-base leading-8 text-muji-muted">{article.summary}</p><section class="mt-8 rounded-2xl border border-muji-border bg-white/85 p-5"><h2 class="text-lg font-semibold">研究方法</h2><ol class="mt-4 list-decimal space-y-3 pl-5 text-sm leading-7">{article.methodology.map(item => <li>{item}</li>)}</ol></section><section class="mt-4 grid gap-4 sm:grid-cols-2"><div class="rounded-2xl border border-muji-border bg-white/85 p-5"><h2 class="text-base font-semibold">前提與假設</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-muji-muted">{article.assumptions.map(item => <li>{item}</li>)}</ul></div><div class="rounded-2xl border border-orange/30 bg-orange/5 p-5"><h2 class="text-base font-semibold text-orange">風險提示</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-muji-muted">{article.risks.map(item => <li>{item}</li>)}</ul></div></section><section class="mt-8 border-t border-muji-border pt-5"><h2 class="text-base font-semibold">來源</h2><ul class="mt-3 space-y-2 text-sm">{article.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="text-muji-brand underline underline-offset-2 hover:text-orange">{source.name}</a><span class="ml-2 text-xs text-muji-muted">擷取於 {source.retrievedAt}</span></li>)}</ul></section></article></main></body></html>
