---
import tools from '../data/tools.json';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import ScenarioSelector from '../components/ScenarioSelector.astro';
import ToolCard from '../components/ToolCard.astro';
import HomeTools from '../components/HomeTools.astro';
import ToolPanel from '../components/ToolPanel.astro';
import ToolPreviewDrawer from '../components/ToolPreviewDrawer.astro';
import Footer from '../components/Footer.astro';

const toolData = JSON.stringify(tools).replace(/</g, '\\u003c');
const siteUrl = 'https://hanjhou2000716.github.io/prstk-lab/';
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PRStK Lab',
  description: '整理投資工具、研究資料與決策流程的研究入口。',
  url: siteUrl,
  inLanguage: 'zh-TW'
}).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="no-referrer">
  <meta name="description" content="整理投資工具、研究資料與決策流程的 PRStK Lab 研究入口。">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; form-action 'self'; frame-src 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests">
  <title>PRStK Lab</title>
  <link rel="canonical" href={siteUrl}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="PRStK Lab">
  <meta property="og:title" content="PRStK Lab｜投資研究工具入口">
  <meta property="og:description" content="整理投資工具、研究資料與決策流程的研究入口。">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:image" content={`${siteUrl}PRStK%20app.png`}>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="PRStK Lab｜投資研究工具入口">
  <meta name="twitter:description" content="整理投資工具、研究資料與決策流程的研究入口。">
  <meta name="twitter:image" content={`${siteUrl}PRStK%20app.png`}>
  <script is:inline type="application/ld+json" set:html={structuredData}></script>

  <!-- App 圖示設定 (iOS 與 Android) -->
  <link rel="apple-touch-icon" href="PRStK app.png">
  <link rel="icon" href="PRStK app.png">
  <link rel="manifest" href="manifest.json">

  <link rel="stylesheet" href="assets/styles.css">
  <!-- Google Fonts: Noto Sans TC & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
  
</head>

<body class="bg-muji-bg text-muji-text font-sans min-h-[100dvh] flex flex-col justify-between overflow-x-hidden">
  <script is:inline id="tool-data" type="application/json" set:html={toolData}></script>
  <ToolCard />
  <!-- 背景微光裝飾（極簡無印風） -->
  <div class="site-background fixed inset-0 pointer-events-none"></div>

  <!-- 主容器 (加寬一點點以容納分類標題，但仍保持適合手機閱讀的尺寸) -->
  <div id="portal-shell" class="relative w-full max-w-[720px] mx-auto h-[100dvh] overflow-hidden flex flex-col justify-between px-5 pt-4 sm:px-8 sm:pt-6 pb-4 z-10">
    
    <Header />

    <main class="flex-1 flex flex-col justify-start min-h-0 w-full space-y-3">
      <SearchBar />
      <ScenarioSelector />
      <HomeTools />
      <div id="category-sections" class="contents" aria-live="polite"></div>
    </main>

    <Footer />

  </div>

  <ToolPanel />

  <ToolPreviewDrawer />

  <script src="../scripts/main.ts"></script>
</body>
</html>
