---
import tools from '../data/tools.json';

const toolData = JSON.stringify(tools).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="no-referrer">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; form-action 'self'; frame-src 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests">
  <title>PRStK Lab</title>

  <!-- App 圖示設定 (iOS 與 Android) -->
  <link rel="apple-touch-icon" href="PRStK app.png">
  <link rel="manifest" href="manifest.json">

  <link rel="stylesheet" href="assets/styles.css">
  <!-- Google Fonts: Noto Sans TC & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <!-- AOS 動畫庫 CSS -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" integrity="sha384-/rJKQnzOkEo+daG0jMjU1IwwY9unxt1NBw3Ef2fmOJ3PW/TfAg2KXVoWwMZQZtw9" crossorigin="anonymous">
  
  <!-- Lucide Icons -->
  <script is:inline src="https://unpkg.com/lucide@0.468.0" integrity="sha384-uTYyvsSSUZeaPhb5RbKlQa0zY/WpX/QHfvg2mczXyBQOpkWPEDy9lczyp+w7SKXu" crossorigin="anonymous"></script>
  
  
  <!-- Global styles are required for ToolCard nodes created by the existing
       client-side catalog renderer after Astro's initial HTML is hydrated. -->
  <style is:global>
    /* 隱藏滾動條，確保無印極簡視覺 */
    body {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    body::-webkit-scrollbar {
      display: none;
    }
    .site-background {
      background-color: #FAF8F5;
      background-image: linear-gradient(rgba(250, 248, 245, 0.08), rgba(250, 248, 245, 0.08)), url('assets/prstk-geometric-background.jpg');
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }
    :focus-visible {
      outline: 3px solid #D97745;
      outline-offset: 3px;
    }
    /* 滑出抽屜動畫 */
    .drawer-transition {
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    /* 卡片懸浮動畫優化，加入 hardware acceleration 避免卡頓 */
    .card-hover-effect {
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      will-change: transform, box-shadow;
    }
    .card-hover-effect:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px -6px rgba(74, 96, 109, 0.15);
      border-color: rgba(74, 96, 109, 0.3);
    }
    .tool-card { animation: card-enter 420ms cubic-bezier(0.16, 1, 0.3, 1) both; overflow: hidden; border-radius: 1rem; }
    .tool-card .card-hover-effect { padding-right: 3rem !important; }
    .tool-card .card-hover-effect > span:first-child { white-space: normal !important; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .tool-action { position: absolute; right: 0; z-index: 10; display: flex; width: 2.65rem; height: 33.333%; align-items: center; justify-content: center; border-left: 1px solid rgba(227, 221, 213, 0.55); background: rgba(255, 255, 255, 0.82); color: rgba(98, 93, 86, 0.78); transition: color 180ms ease, background 180ms ease; }
    .tool-action:hover { background: #EEF2F4; color: #1F3546; }
    .favorite-action { top: 0; border-bottom: 1px solid rgba(227, 221, 213, 0.42); }
    .pin-action { top: 33.333%; border-bottom: 1px solid rgba(227, 221, 213, 0.42); }
    .info-action { bottom: 0; }
    .tool-card.is-favorite .favorite-icon { fill: #D97745; stroke: #D97745; }
    .filter-chip[aria-pressed="true"] { background: #1F3546; border-color: #1F3546; color: #fff; }
    .scenario-entry[aria-pressed="true"] { background: #EEF2F4; border-color: #4A606D; box-shadow: 0 4px 14px rgba(74, 96, 109, 0.12); }
    .pin-button[aria-pressed="true"] { background: #D97745; color: #fff; border-color: #D97745; }
    .tool-panel-open { overflow: hidden; }
    .tool-panel-surface {
      background-color: #FAF8F5;
      background-image: linear-gradient(rgba(250, 250, 249, 0.82), rgba(250, 250, 249, 0.82)), url('assets/prstk-geometric-background.jpg');
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      animation: panel-reveal 280ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .tool-panel-surface #tool-panel-grid { scroll-padding: 0.25rem 0 1.5rem; }
    .tool-panel-surface .tool-card .card-hover-effect { background: rgba(255, 255, 255, 0.88); }
    #category-filters { scrollbar-width: none; }
    #category-filters::-webkit-scrollbar { display: none; }
    /* 首頁只負責快速瀏覽；收藏、釘選與詳細資訊集中在完整工具面板。 */
    #home-card-grid { grid-template-rows: repeat(2, 4.15rem); }
    #home-card-grid .tool-card { min-height: 4.15rem; }
    #home-card-grid .tool-action { display: none; }
    #home-card-grid .card-hover-effect { min-height: 4.15rem; padding: 0.5rem 0.7rem !important; }
    #home-card-grid .card-hover-effect > span:first-child { font-size: clamp(0.68rem, 2.8vw, 0.8rem) !important; line-height: 1.18 !important; }
    #home-card-grid .card-hover-effect > span:nth-child(2) { margin-top: 0.2rem !important; font-size: clamp(0.58rem, 2.3vw, 0.68rem) !important; }
    #home-card-grid.show-actions { grid-template-rows: repeat(2, 5.2rem); }
    #home-card-grid.show-actions .tool-card,
    #home-card-grid.show-actions .card-hover-effect { min-height: 5.2rem; }
    #home-card-grid.show-actions .tool-action { display: flex; width: 2.45rem; }
    #home-card-grid.show-actions .card-hover-effect { padding: 0.55rem 2.8rem 0.55rem 0.65rem !important; }
    #home-tools { margin-top: 1.75rem !important; }
    #home-card-grid.is-updating { animation: content-settle 240ms ease-out both; }
    #drawer-overlay { z-index: 70; }
    #info-drawer { z-index: 80; }
    @media (hover: none) {
      .card-hover-effect:active { transform: scale(0.985); box-shadow: 0 4px 14px -7px rgba(74, 96, 109, 0.3); }
      .filter-chip:active, #view-all-tools:active, .scenario-entry:active { transform: scale(0.96); }
    }
    @media (max-width: 640px) {
      #portal-shell { padding-top: 4rem; }
      /* 搜尋區上移一行；情境入口保留原本的視覺位置。 */
      #portal-shell > header { margin-bottom: 1.5rem; }
      #logo-img { width: 77% !important; max-height: 12vh; }
      #tool-search-panel { padding: 0.75rem !important; }
      #tool-search-panel #category-filters { margin-top: 0.75rem; }
      #tool-search-panel > div:last-child { margin-top: 0.5rem; }
      #scenario-entries { margin-top: 0.5rem; }
      /* 首頁內容上收一格，讓四張卡與頁尾留在單頁視窗內。 */
      #home-tools { margin-top: 1rem !important; }
      #home-tools > div:first-child { margin-bottom: 0.75rem; }
      #home-card-grid { gap: 0.65rem; grid-template-rows: repeat(2, 3.85rem); }
      #home-card-grid .tool-card,
      #home-card-grid .card-hover-effect { min-height: 3.85rem; }
      #scenario-entries .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.45rem; overflow: visible; }
      #scenario-entries .scenario-entry { min-width: 0; min-height: 2.5rem; padding: 0.45rem 0.2rem; flex-direction: column; justify-content: center; gap: 0.15rem; text-align: center; white-space: nowrap; }
      #scenario-entries .scenario-entry i { width: 0.9rem; height: 0.9rem; }
      #scenario-entries .scenario-entry span { font-size: 0.64rem; letter-spacing: 0; }
    }
    @media (max-width: 640px) and (max-height: 740px) {
      #portal-shell { padding-top: clamp(2rem, 7vh, 3rem); }
      #portal-shell > header { margin-bottom: 1.5rem; }
      #home-tools { margin-top: 1rem !important; }
      #home-tools > div:first-child { margin-bottom: 0.75rem; }
    }
    @media (min-width: 641px) {
      body { overflow-y: auto; scrollbar-width: thin; scrollbar-color: #91A69A transparent; }
      body::-webkit-scrollbar { display: block; width: 8px; }
      body::-webkit-scrollbar-thumb { background: #91A69A; border-radius: 999px; }
      body::-webkit-scrollbar-track { background: transparent; }
      #portal-shell { height: auto; min-height: 100dvh; overflow: visible; padding: 2.5rem 2rem 2rem; }
      #portal-shell > header { margin-bottom: 2.5rem; }
      #portal-shell > main { flex: 0 0 auto; }
      #home-tools { margin-top: 2.25rem !important; }
      #home-tools > div:first-child { margin-bottom: 1rem; }
      #home-card-grid { grid-template-rows: repeat(2, 5.5rem); gap: 1rem; }
      #home-card-grid .tool-card,
      #home-card-grid .card-hover-effect { min-height: 5.5rem; }
      #home-card-grid .card-hover-effect { padding: 0.9rem 1rem !important; }
      #home-card-grid .card-hover-effect > span:first-child { font-size: 0.9rem !important; }
      #home-card-grid .card-hover-effect > span:nth-child(2) { font-size: 0.72rem !important; }
      #home-card-grid.show-actions { grid-template-rows: repeat(2, 6.25rem); }
      #home-card-grid.show-actions .tool-card,
      #home-card-grid.show-actions .card-hover-effect { min-height: 6.25rem; }
      .tool-panel-surface { background-position: center top; background-size: min(100vw, 720px) auto; }
      #category-filters { overflow-x: scroll; padding-bottom: 0.65rem; scrollbar-width: thin; scrollbar-color: #91A69A #EEF2F4; }
      #category-filters > .filter-chip { min-width: 6.5rem; justify-content: center; }
      #category-filters > .filter-chip:first-child { min-width: 7.5rem; }
      #category-filters::-webkit-scrollbar { display: block; height: 7px; }
      #category-filters::-webkit-scrollbar-track { background: #EEF2F4; border-radius: 999px; }
      #category-filters::-webkit-scrollbar-thumb { background: #91A69A; border: 2px solid #EEF2F4; border-radius: 999px; }
      footer { margin-top: 2.5rem !important; }
      .site-background { background-position: center top; background-size: min(100vw, 720px) auto; }
    }
    @media (max-width: 480px) {
      .tool-card .card-hover-effect { padding: 0.8rem 3rem 0.7rem 0.8rem !important; }
      .tool-card .card-hover-effect > span:first-child { font-size: 0.88rem !important; line-height: 1.25 !important; }
      .tool-card .card-hover-effect > span:nth-child(2) { margin-top: 0.35rem !important; font-size: 0.7rem !important; }
      #home-card-grid { gap: 0.6rem; grid-template-rows: repeat(2, 3.7rem); }
      #home-card-grid .tool-card,
      #home-card-grid .card-hover-effect { min-height: 3.7rem; }
      #home-card-grid .card-hover-effect { padding: 0.45rem 0.65rem !important; }
      #home-card-grid .card-hover-effect > span:first-child { font-size: clamp(0.66rem, 2.8vw, 0.76rem) !important; line-height: 1.18 !important; }
      #home-card-grid .card-hover-effect > span:nth-child(2) { margin-top: 0.15rem !important; font-size: clamp(0.55rem, 2.25vw, 0.64rem) !important; }
      #home-card-grid.show-actions { grid-template-rows: repeat(2, 4.8rem); }
      #home-card-grid.show-actions .tool-card,
      #home-card-grid.show-actions .card-hover-effect { min-height: 4.8rem; }
      #home-card-grid.show-actions .card-hover-effect { padding: 0.45rem 2.7rem 0.45rem 0.6rem !important; }
    }
    @keyframes card-enter {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes content-settle {
      from { opacity: 0.72; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes panel-reveal {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: no-preference) {
      .scenario-entry { animation: scenario-pop 360ms cubic-bezier(0.16, 1, 0.3, 1) both; }
      .scenario-entry:nth-child(2) { animation-delay: 40ms; }
      .scenario-entry:nth-child(3) { animation-delay: 80ms; }
      .scenario-entry:nth-child(4) { animation-delay: 120ms; }
    }
    @keyframes scenario-pop {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 1ms !important; transition-duration: 1ms !important; scroll-behavior: auto !important; }
    }
    /* 自訂抽屜內部滾動條 */
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #E3DDD5;
      border-radius: 4px;
    }
  </style>

  <script>
    // @ts-nocheck
    function handleLogoError() {
      const img = document.getElementById('logo-img');
      const fallback = document.getElementById('logo-fallback');
      if (img) img.style.display = 'none';
      if (fallback) fallback.classList.remove('hidden');
    }
  </script>
</head>

<body class="bg-muji-bg text-muji-text font-sans min-h-[100dvh] flex flex-col justify-between overflow-x-hidden">
  <script is:inline id="tool-data" type="application/json" set:html={toolData}></script>
  <!-- 背景微光裝飾（極簡無印風） -->
  <div class="site-background fixed inset-0 pointer-events-none"></div>

  <!-- 主容器 (加寬一點點以容納分類標題，但仍保持適合手機閱讀的尺寸) -->
  <div id="portal-shell" class="relative w-full max-w-[720px] mx-auto h-[100dvh] overflow-hidden flex flex-col justify-between px-5 pt-4 sm:px-8 sm:pt-6 pb-4 z-10">
    
    <!-- ================= 1. 頭部區域 ================= -->
    <header class="flex flex-col items-center text-center mb-7">
       <!-- 標誌圖片 -->
      <div class="w-full flex items-center justify-center mb-1" data-aos="fade-down" data-aos-duration="800">
        <img 
          id="logo-img"
          src="PRStK Lab-Remove.png" 
          alt="PRStK Lab Logo" 
          class="w-[72%] max-w-[270px] h-auto max-h-[12vh] object-contain transition-opacity duration-300"
          onerror="handleLogoError()"
        />
        <!-- 備用純文字 Logo -->
        <div id="logo-fallback" class="hidden flex-col items-center">
          <span class="text-3xl font-light tracking-[0.25em] text-muji-brand">PRStK Lab</span>
          <span class="text-[11px] uppercase tracking-[0.4em] text-muji-muted mt-1">Quant Trading</span>
        </div>
      </div>
      
      <!-- ⭐ 乾淨純粹的 Slogan -->
      <p class="text-[13px] tracking-[0.16em] text-muji-muted font-normal flex items-center justify-center mt-1" data-aos="fade-in" data-aos-delay="100" data-aos-duration="1000">
        <span>想和你一起慢慢變富。</span>
      </p>
    </header>

    <!-- ================= 2. 分類導覽區 ================= -->
    <main class="flex-1 flex flex-col justify-start min-h-0 w-full space-y-3">
      
      <section id="tool-search-panel" class="rounded-3xl border border-muji-border/80 bg-white/80 p-4 sm:p-5 shadow-sm backdrop-blur-sm" aria-label="工具搜尋與篩選" data-aos="fade-up">
        <div class="flex flex-row gap-2 items-center">
          <label class="relative block flex-1">
            <span class="sr-only">搜尋工具</span>
            <i data-lucide="search" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muji-muted"></i>
            <input id="tool-search" type="search" autocomplete="off" placeholder="搜尋工具、功能或適合對象" class="w-full rounded-xl border border-muji-border bg-muji-bg/70 py-3 pl-10 pr-4 text-sm text-muji-text placeholder:text-muji-muted/60 transition focus:border-muji-brand focus:bg-white focus:outline-none" />
          </label>
          <button id="favorites-filter" type="button" aria-label="只顯示我的最愛" title="我的最愛" aria-pressed="false" class="filter-chip inline-flex shrink-0 items-center justify-center rounded-xl border border-muji-border bg-white px-3 py-3 text-xs font-medium text-muji-brand transition hover:border-orange hover:text-orange">
            <i data-lucide="heart" class="h-4 w-4"></i>
          </button>
        </div>
        <div id="category-filters" class="mt-4 flex gap-2 overflow-x-auto pb-1" aria-label="工具分類"></div>
        <div class="mt-3 flex items-center justify-between gap-3">
          <p id="tool-result-summary" class="text-xs text-muji-muted" aria-live="polite"></p>
          <button id="view-all-tools" type="button" class="hidden text-xs font-medium text-muji-brand hover:text-orange">查看全部</button>
        </div>
      </section>

      <section id="scenario-entries" aria-label="投資情境快捷入口" data-aos="fade-up" data-aos-delay="80">
        <div class="grid grid-cols-4 gap-2">
          <button type="button" data-scenario-category="explore" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
            <i data-lucide="sparkles" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
            <span class="text-xs font-medium tracking-wide text-muji-text">找機會</span>
          </button>
          <button type="button" data-scenario-category="research" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
            <i data-lucide="search-check" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
            <span class="text-xs font-medium tracking-wide text-muji-text">做研究</span>
          </button>
          <button type="button" data-scenario-category="risk" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
            <i data-lucide="shield-alert" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
            <span class="text-xs font-medium tracking-wide text-muji-text">看風險</span>
          </button>
          <button type="button" data-scenario-category="allocation" class="scenario-entry group flex items-center gap-2 rounded-2xl border border-muji-border/80 bg-white/75 px-3 py-3 text-left transition hover:-translate-y-0.5 hover:border-muji-brand hover:bg-white">
            <i data-lucide="landmark" class="h-4 w-4 shrink-0 text-muji-brand transition-transform group-hover:scale-110"></i>
            <span class="text-xs font-medium tracking-wide text-muji-text">做配置</span>
          </button>
        </div>
      </section>

       <section id="home-tools" class="flex-none flex flex-col" aria-label="首頁工具">
        <div class="mb-2 flex items-center justify-between">
          <h2 id="home-tools-title" class="text-xs font-semibold leading-none tracking-[0.12em] text-muji-section">為你精選</h2>
          <span class="text-[10px] leading-none text-muji-muted/70">最多 4 個</span>
        </div>
         <div id="home-card-grid" class="grid grid-cols-2 gap-3"></div>
        <p id="home-empty" class="hidden flex-1 items-center justify-center rounded-2xl border border-dashed border-muji-border bg-white/55 px-8 text-center text-sm leading-6 text-muji-muted"></p>
      </section>

      <div id="category-sections" class="contents" aria-live="polite"></div>
    </main>

    <!-- ================= 3. 頁尾資訊 ================= -->
    <footer class="text-center flex flex-col items-center gap-2 mt-3 pt-3 pb-0 border-t border-muji-border/50" data-aos="fade-up">
      <!-- ⭐ Telegram Bot 連結按鈕 -->
      <a href="https://t.me/PRStK_Lab_bot" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="flex items-center gap-2.5 px-7 py-2.5 text-[13px] text-muji-brand hover:text-white border border-muji-brand/30 rounded-full hover:bg-muji-brand hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 shadow-sm bg-white/50 backdrop-blur-sm">
        <i data-lucide="send" class="w-3.5 h-3.5"></i>
        <span class="font-medium tracking-widest">Together Better</span>
      </a>
      
      <p class="text-[10px] text-muji-muted/60 tracking-widest font-light mt-1">
        © 2026 PRStK Lab. All rights reserved.
      </p>
    </footer>

  </div>

  <section id="tool-panel" role="dialog" aria-modal="true" aria-labelledby="tool-panel-title" aria-hidden="true" class="tool-panel-surface fixed inset-0 z-[60] hidden px-5 py-6 backdrop-blur-sm">
    <div class="mx-auto flex h-full max-w-[720px] flex-col">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <p class="text-[10px] tracking-[0.15em] text-muji-muted">PRStK LAB</p>
          <h2 id="tool-panel-title" class="mt-1 text-lg font-semibold text-muji-text">全部工具</h2>
        </div>
        <button id="close-tool-panel" type="button" aria-label="關閉全部工具" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-muji-border bg-white text-muji-brand transition hover:border-orange hover:text-orange">
          <i data-lucide="x" class="h-4 w-4"></i>
        </button>
      </div>
      <div id="tool-panel-grid" class="grid flex-1 auto-rows-min grid-cols-1 gap-3 overflow-y-auto pb-6 sm:grid-cols-2"></div>
    </div>
  </section>

  <!-- ================= 詳細資訊彈出抽屜 (Drawer) ================= -->
  <!-- 遮罩背景 -->
  <div id="drawer-overlay" aria-hidden="true"
       class="fixed inset-0 bg-muji-text/30 backdrop-blur-[2px] z-[70] hidden opacity-0 transition-opacity duration-400">
  </div>

  <!-- 內容卡片 -->
  <div id="info-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true" tabindex="-1"
       class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white rounded-t-[28px] shadow-[0_-12px_40px_rgba(74,96,109,0.15)] z-[80] transform translate-y-full drawer-transition border-t border-muji-border max-h-[85vh] flex flex-col">
    
    <!-- 頂部滑動裝飾條 -->
    <button type="button" data-drawer-close aria-label="關閉詳細資訊" class="flex-shrink-0 pt-3.5 pb-1 cursor-pointer flex justify-center w-full">
      <div class="w-12 h-1.5 bg-muji-border/80 rounded-full hover:bg-muji-brand/40 transition-colors"></div>
    </button>
    
    <!-- 抽屜內容 -->
    <div class="px-7 pb-8 pt-2 overflow-y-auto flex-1 custom-scrollbar">
      
      <!-- 標題與網址 -->
      <div class="flex justify-between items-start mb-6">
        <div class="pr-4">
          <h3 id="drawer-title" class="text-[19px] font-semibold tracking-wider text-muji-text">標題</h3>
          <p id="drawer-subtitle" class="text-[11px] text-muji-brand mt-1.5 tracking-widest font-medium bg-muji-brandLight inline-block px-2.5 py-0.5 rounded-md"></p>
        </div>
        <button type="button" data-drawer-close aria-label="關閉詳細資訊" class="p-2 rounded-full hover:bg-muji-bg text-muji-muted hover:text-muji-brand transition-all flex-shrink-0 active:scale-95 bg-white shadow-sm border border-muji-border/30">
          <i data-lucide="x" class="w-4.5 h-4.5"></i>
        </button>
      </div>

      <!-- 詳細說明區塊 -->
      <div class="space-y-4">
        <!-- 核心功能 -->
        <div class="bg-[#FCFAFC] p-5 rounded-2xl border border-muji-border/60 shadow-sm">
          <h4 class="text-[12px] tracking-[0.15em] text-muji-brand font-bold flex items-center gap-2 mb-3.5">
            <i data-lucide="sparkles" class="w-4 h-4"></i>
            核心功能
          </h4>
          <ul id="drawer-features" class="text-[13px] text-muji-text font-normal leading-[1.75] space-y-3">
          </ul>
        </div>

        <!-- 適合對象 -->
        <div class="bg-[#FCFAFC] p-5 rounded-2xl border border-muji-border/60 shadow-sm">
          <h4 class="text-[12px] tracking-[0.15em] text-muji-brand font-bold flex items-center gap-2 mb-3.5">
            <i data-lucide="users" class="w-4 h-4"></i>
            適合對象
          </h4>
          <ul id="drawer-targets" class="text-[13px] text-muji-text font-normal leading-[1.75] space-y-3">
          </ul>
        </div>
      </div>

      <!-- 快速前往按鈕 -->
      <div class="mt-8 pt-1">
        <a id="drawer-link" href="#" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
           class="group flex items-center justify-center gap-2.5 w-full py-4 bg-muji-brand hover:bg-[#384a54] text-white text-[13.5px] font-medium tracking-widest rounded-xl transition-all duration-300 shadow-[0_4px_15px_rgba(74,96,109,0.2)] hover:shadow-[0_6px_20px_rgba(74,96,109,0.3)] hover:-translate-y-0.5 active:scale-[0.98]">
          <span>開啟系統</span>
          <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1.5 transition-transform"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- AOS 動畫庫 JS 初始化 -->
  <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js" integrity="sha384-wziAfh6b/qT+3LrqebF9WeK4+J5sehS6FA10J1t3a866kJ/fvU5UwofWnQyzLtwu" crossorigin="anonymous"></script>
  <script>
    // @ts-nocheck
    // 優化動畫：取消個別過長的 delay，改由整組 fade-up 解決卡頓感
    AOS.init({
      duration: 600,
      easing: 'ease-out-cubic',
      once: true,
      offset: 10
    });

    lucide.createIcons();

    // Secure every external destination, including future cards added in HTML.
    document.querySelectorAll('a[target="_blank"]').forEach(link => {
      link.rel = 'noopener noreferrer';
      link.referrerPolicy = 'no-referrer';
    });

    let drawerPreviousFocus = null;
    let panelPreviousFocus = null;
    let closeTimer = null;

    // 工具唯一資料來源：固定 ID、分類、內容與連結都在此維護。
    const toolDataElement = document.getElementById('tool-data');
    const toolCatalog = toolDataElement ? JSON.parse(toolDataElement.textContent || '[]') : [];


    const categories = [
      { id: 'explore', label: '探索', icon: 'compass' },
      { id: 'research', label: '研究', icon: 'book-open' },
      { id: 'strategy', label: '策略', icon: 'chart-no-axes-combined' },
      { id: 'risk', label: '風控', icon: 'shield-check' },
      { id: 'allocation', label: '配置', icon: 'pie-chart' }
    ];

    const toolById = new Map(toolCatalog.map(tool => [tool.id, tool]));
    const favoritesStorageKey = 'prstk-lab-favorites-v2';
    const pinsStorageKey = 'prstk-lab-pins-v2';
    const legacyFavoritesStorageKey = 'prstk-lab-favorites';
    const legacyPinsStorageKey = 'prstk-lab-pins';
    const recommendedToolIds = ['stockintelli', 'quantgems', 'solitude', 'twstock-pulse'];
    const readStoredSet = key => {
      try {
        const values = JSON.parse(localStorage.getItem(key) || '[]');
        return new Set(Array.isArray(values) ? values.filter(value => typeof value === 'string' && toolById.has(value)) : []);
      } catch { return new Set(); }
    };
    const saveStoredSet = (key, values) => {
      try { localStorage.setItem(key, JSON.stringify([...values])); }
      catch { /* Browsing remains fully usable when storage is unavailable. */ }
    };
    const migrateLegacySet = (storageKey, legacyKey) => {
      const current = readStoredSet(storageKey);
      if (current.size || localStorage.getItem(storageKey) !== null) return current;
      try {
        const legacyValues = JSON.parse(localStorage.getItem(legacyKey) || '[]');
        const migrated = new Set((Array.isArray(legacyValues) ? legacyValues : [])
          .map(index => toolCatalog[Number(index)]?.id)
          .filter(Boolean));
        saveStoredSet(storageKey, migrated);
        return migrated;
      } catch { return new Set(); }
    };

    const favorites = migrateLegacySet(favoritesStorageKey, legacyFavoritesStorageKey);
    const pins = migrateLegacySet(pinsStorageKey, legacyPinsStorageKey);
    let activeCategory = 'all';
    let favoritesOnly = false;
    let panelOpen = false;
    let currentMatches = [];
    let homeRefreshTimer;
    const toolSearch = document.getElementById('tool-search');
    const favoritesFilter = document.getElementById('favorites-filter');
    const categoryFilters = document.getElementById('category-filters');
    const resultSummary = document.getElementById('tool-result-summary');
    const homeGrid = document.getElementById('home-card-grid');
    const homeTitle = document.getElementById('home-tools-title');
    const homeEmpty = document.getElementById('home-empty');
    const viewAllTools = document.getElementById('view-all-tools');
    const toolPanel = document.getElementById('tool-panel');
    const toolPanelGrid = document.getElementById('tool-panel-grid');
    const toolPanelTitle = document.getElementById('tool-panel-title');
    const closeToolPanel = document.getElementById('close-tool-panel');
    const portalShell = document.getElementById('portal-shell');
    const drawerOverlay = document.getElementById('drawer-overlay');
    const infoDrawer = document.getElementById('info-drawer');
    const categorySections = document.getElementById('category-sections');
    const toolCards = [];
    const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    const trapFocus = (event, container) => {
      if (event.key !== 'Tab') return;
      const focusable = [...container.querySelectorAll(focusableSelector)]
        .filter(element => !element.hidden && element.getClientRects().length);
      if (!focusable.length) {
        event.preventDefault();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const makeFilterChip = (id, label, icon) => {
      const button = document.createElement('button');
      const iconElement = document.createElement('i');
      button.type = 'button';
      button.dataset.category = id;
      button.setAttribute('aria-pressed', id === 'all' ? 'true' : 'false');
      button.className = 'filter-chip inline-flex shrink-0 items-center gap-1.5 rounded-full border border-muji-border bg-white px-3 py-2 text-xs text-muji-brand transition hover:border-sage hover:text-muji-brand';
      iconElement.setAttribute('data-lucide', icon);
      iconElement.className = 'h-3.5 w-3.5';
      button.append(iconElement, document.createTextNode(label));
      return button;
    };

    categoryFilters.append(makeFilterChip('all', '全部', 'grid-2x2'));
    categories.forEach(category => categoryFilters.append(makeFilterChip(category.id, category.label, category.icon)));

    const createToolCard = tool => {
      const card = document.createElement('div');
      const link = document.createElement('a');
      const title = document.createElement('span');
      const subtitle = document.createElement('span');
      const detailButton = document.createElement('button');
      const detailIcon = document.createElement('i');

      card.className = 'relative group h-full';
      link.href = tool.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.referrerPolicy = 'no-referrer';
      link.className = 'flex flex-col justify-center w-full h-full min-h-[76px] py-4 pl-3.5 pr-9 bg-white border border-muji-border/80 rounded-2xl shadow-sm card-hover-effect';
      title.className = 'text-[13px] font-medium tracking-wide text-muji-text group-hover:text-muji-brand transition-colors leading-tight truncate';
      title.textContent = tool.name;
      subtitle.className = 'text-[10px] text-muji-muted/80 tracking-wider mt-1.5 font-light block truncate';
      subtitle.textContent = tool.brandName;
      link.append(title, subtitle);

      detailButton.type = 'button';
      detailButton.dataset.toolId = tool.id;
      detailButton.className = 'tool-action info-action';
      detailButton.setAttribute('aria-label', `詳細資訊：${tool.brandName}`);
      detailIcon.setAttribute('data-lucide', 'info');
      detailIcon.className = 'w-4 h-4 text-muji-muted/50 hover:text-muji-brand transition-colors';
      detailButton.appendChild(detailIcon);
      card.append(link, detailButton);
      return card;
    };

    const setupToolCard = (card, tool, category, index) => {
      const toolId = tool.id;
      card.classList.add('tool-card');
      card.dataset.toolId = toolId;
      card.dataset.category = category.id;
      card.style.animationDelay = `${Math.min(index * 45, 180)}ms`;
      if (favorites.has(toolId)) card.classList.add('is-favorite');

      const detailButton = card.querySelector('button[data-tool-id]');
      detailButton.dataset.drawerTrigger = toolId;
      detailButton.setAttribute('aria-controls', 'info-drawer');
      detailButton.setAttribute('aria-expanded', 'false');
      detailButton.addEventListener('click', () => openDrawer(toolId));

      const favoriteButton = document.createElement('button');
      const favoriteIcon = document.createElement('i');
      favoriteButton.type = 'button';
      favoriteButton.className = 'tool-action favorite-action';
      favoriteButton.setAttribute('aria-label', `加入最愛：${tool.brandName}`);
      favoriteButton.setAttribute('aria-pressed', String(favorites.has(toolId)));
      favoriteIcon.setAttribute('data-lucide', 'heart');
      favoriteIcon.className = 'favorite-icon h-3.5 w-3.5';
      favoriteButton.appendChild(favoriteIcon);
      favoriteButton.addEventListener('click', () => {
        if (favorites.has(toolId)) favorites.delete(toolId);
        else favorites.add(toolId);
        saveStoredSet(favoritesStorageKey, favorites);
        favoriteButton.setAttribute('aria-pressed', String(favorites.has(toolId)));
        card.classList.toggle('is-favorite', favorites.has(toolId));
        applyFilters();
      });
      card.appendChild(favoriteButton);

      const pinButton = document.createElement('button');
      const pinIcon = document.createElement('i');
      pinButton.type = 'button';
      pinButton.className = 'tool-action pin-action pin-button';
      pinButton.setAttribute('aria-label', `釘選工具：${tool.brandName}`);
      pinButton.setAttribute('aria-pressed', String(pins.has(toolId)));
      pinIcon.setAttribute('data-lucide', 'pin');
      pinIcon.className = 'h-3.5 w-3.5';
      pinButton.appendChild(pinIcon);
      pinButton.addEventListener('click', () => {
        if (pins.has(toolId)) {
          pins.delete(toolId);
        } else if (pins.size < 4) {
          pins.add(toolId);
        } else {
          resultSummary.textContent = '首頁最多釘選 4 個工具，請先取消一個圖釘。';
          return;
        }
        saveStoredSet(pinsStorageKey, pins);
        pinButton.setAttribute('aria-pressed', String(pins.has(toolId)));
        applyFilters();
      });
      card.appendChild(pinButton);
      toolCards.push({ card, section: null, tool, toolId });
    };

    const renderCatalogSections = () => {
      categorySections.replaceChildren();
      categories.forEach(category => {
        const section = document.createElement('section');
        const heading = document.createElement('h2');
        const icon = document.createElement('i');
        const grid = document.createElement('div');
        section.dataset.category = category.id;
        section.dataset.aos = 'fade-up';
        section.hidden = true;
        heading.className = 'text-[12px] font-semibold text-muji-section tracking-[0.1em] flex items-center gap-2 mb-3 pl-1';
        icon.setAttribute('data-lucide', category.icon);
        icon.className = 'w-3.5 h-3.5';
        heading.append(icon, document.createTextNode(category.label));
        grid.className = 'grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3';
        toolCatalog
          .filter(tool => tool.categories.includes(category.id))
          .forEach((tool, index) => {
            const card = createToolCard(tool);
            grid.appendChild(card);
            setupToolCard(card, tool, category, index);
          });
        section.append(heading, grid);
        categorySections.appendChild(section);
      });
      lucide.createIcons();
      AOS.refresh?.();
    };

    renderCatalogSections();

    const getMatches = () => {
      const query = toolSearch.value.trim().toLocaleLowerCase('zh-TW');
      return toolCards.filter(({ card, tool, toolId }) => {
        const searchableText = [
          tool.name,
          tool.brandName,
          tool.summary,
          tool.description,
          ...tool.features,
          ...tool.useCases,
          ...tool.targetUsers,
          ...tool.tags,
          ...tool.aliases
        ].join(' ').toLocaleLowerCase('zh-TW');
        return (!query || searchableText.includes(query))
          && (activeCategory === 'all' || card.dataset.category === activeCategory)
          && (!favoritesOnly || favorites.has(toolId));
      });
    };

    const moveCardsTo = (entries, target) => {
      target.replaceChildren();
      toolCards.forEach(({ card }) => { card.hidden = true; });
      entries.forEach(({ card }) => {
        card.hidden = false;
        target.appendChild(card);
      });
    };

    const renderHome = entries => {
      const isDefaultView = !toolSearch.value.trim() && activeCategory === 'all' && !favoritesOnly;
      const showHomeActions = activeCategory !== 'all';
      const pinnedEntries = toolCards.filter(({ toolId }) => pins.has(toolId));
      const recommendedEntries = recommendedToolIds.map(id => toolCards.find(({ toolId }) => toolId === id)).filter(Boolean);
      const displayEntries = isDefaultView && pinnedEntries.length
        ? [...pinnedEntries, ...recommendedEntries.filter(({ toolId }) => !pins.has(toolId))]
        : (isDefaultView ? recommendedEntries : entries);
      const title = isDefaultView ? (pinnedEntries.length ? '我的首頁' : '為你精選') : '搜尋結果';

      homeTitle.textContent = title;
      homeEmpty.classList.toggle('hidden', displayEntries.length > 0);
      homeEmpty.classList.toggle('flex', displayEntries.length === 0);
      if (!displayEntries.length) {
        homeEmpty.textContent = favoritesOnly ? '尚未收藏工具，請點擊卡片上的愛心。' : '沒有符合的工具，請嘗試其他關鍵字或分類。';
      }
      moveCardsTo(displayEntries.slice(0, 4), homeGrid);
      homeGrid.classList.toggle('show-actions', showHomeActions);
      resultSummary.textContent = isDefaultView
        ? (pinnedEntries.length ? `已釘選 ${pinnedEntries.length} / 4 個工具` : '預設推薦 4 個工具，可用圖釘自訂首頁')
        : (entries.length ? `找到 ${entries.length} 個工具，顯示前 4 個` : '沒有符合的工具');
      viewAllTools.classList.toggle('hidden', entries.length <= 4);
    };

    const renderPanel = entries => {
      toolPanelTitle.textContent = `全部工具 · ${entries.length}`;
      moveCardsTo(entries, toolPanelGrid);
    };

    const animateHomeUpdate = () => {
      homeGrid.classList.remove('is-updating');
      void homeGrid.offsetWidth;
      homeGrid.classList.add('is-updating');
      clearTimeout(homeRefreshTimer);
      homeRefreshTimer = setTimeout(() => homeGrid.classList.remove('is-updating'), 260);
    };

    function applyFilters() {
      currentMatches = getMatches();
      if (panelOpen) renderPanel(currentMatches);
      else {
        renderHome(currentMatches);
        animateHomeUpdate();
      }
    }

    const setCategory = categoryId => {
      activeCategory = categoryId;
      categoryFilters.querySelectorAll('button[data-category]').forEach(chip => {
        chip.setAttribute('aria-pressed', String(chip.dataset.category === categoryId));
      });
      applyFilters();
    };

    categoryFilters.addEventListener('click', event => {
      const button = event.target.closest('button[data-category]');
      if (!button) return;
      setCategory(button.dataset.category);
    });
    document.querySelectorAll('[data-scenario-category]').forEach(button => {
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => {
        toolSearch.value = '';
        favoritesOnly = false;
        favoritesFilter.setAttribute('aria-pressed', 'false');
        document.querySelectorAll('[data-scenario-category]').forEach(entry => {
          entry.setAttribute('aria-pressed', String(entry === button));
        });
        setCategory(button.dataset.scenarioCategory);
      });
    });
    toolSearch.addEventListener('input', applyFilters);
    favoritesFilter.addEventListener('click', () => {
      favoritesOnly = !favoritesOnly;
      favoritesFilter.setAttribute('aria-pressed', String(favoritesOnly));
      applyFilters();
    });
    viewAllTools.addEventListener('click', () => {
      panelPreviousFocus = document.activeElement;
      panelOpen = true;
      toolPanel.classList.remove('hidden');
      toolPanel.setAttribute('aria-hidden', 'false');
      document.body.classList.add('tool-panel-open');
      portalShell.inert = true;
      renderPanel(currentMatches);
      closeToolPanel.focus();
    });
    const closePanel = () => {
      panelOpen = false;
      toolPanel.classList.add('hidden');
      toolPanel.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('tool-panel-open');
      portalShell.inert = false;
      applyFilters();
      panelPreviousFocus?.focus?.();
    };
    closeToolPanel.addEventListener('click', closePanel);
    applyFilters();
    lucide.createIcons();

    function renderList(list, items, markerClass) {
      list.replaceChildren();
      items.forEach(item => {
        const li = document.createElement('li');
        const marker = document.createElement('span');
        const text = document.createElement('span');
        li.className = 'flex items-start gap-3 relative';
        marker.className = `mt-2.5 w-1.5 h-1.5 rounded-full ${markerClass} flex-shrink-0`;
        text.className = 'flex-1';
        text.textContent = item;
        li.append(marker, text);
        list.appendChild(li);
      });
    }

    function openDrawer(toolId) {
      const data = toolById.get(toolId);
      if (!data) return;
      clearTimeout(closeTimer);
      drawerPreviousFocus = document.activeElement;
      
      document.getElementById('drawer-title').innerText = data.name;
      document.getElementById('drawer-subtitle').innerText = data.brandName;
      document.getElementById('drawer-link').href = data.url;

      const featuresUl = document.getElementById('drawer-features');
      renderList(featuresUl, data.features, 'bg-muji-brand/60');

      const targetsUl = document.getElementById('drawer-targets');
      renderList(targetsUl, data.targetUsers, 'bg-muji-accent/60');

      document.querySelectorAll('[data-drawer-trigger]').forEach(button => {
        button.setAttribute('aria-expanded', 'false');
      });
      const trigger = document.querySelector(`[data-drawer-trigger="${toolId}"]`);
      trigger?.setAttribute('aria-expanded', 'true');
      drawerOverlay.classList.remove('hidden');
      drawerOverlay.setAttribute('aria-hidden', 'false');
      infoDrawer.setAttribute('aria-hidden', 'false');
      if (panelOpen) toolPanel.inert = true;
      else portalShell.inert = true;
      setTimeout(() => {
        drawerOverlay.classList.add('opacity-100');
        infoDrawer.classList.remove('translate-y-full');
        infoDrawer.querySelector('[data-drawer-close]')?.focus();
      }, 10);
    }

    function closeDrawer() {
      drawerOverlay.classList.remove('opacity-100');
      infoDrawer.classList.add('translate-y-full');
      drawerOverlay.setAttribute('aria-hidden', 'true');
      infoDrawer.setAttribute('aria-hidden', 'true');
      if (panelOpen) toolPanel.inert = false;
      else portalShell.inert = false;
      document.querySelectorAll('[data-drawer-trigger]').forEach(button => button.setAttribute('aria-expanded', 'false'));
      
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        drawerOverlay.classList.add('hidden');
        drawerPreviousFocus?.focus?.();
      }, 400); // 對應 css 動畫的 0.4s
    }

    drawerOverlay.addEventListener('click', closeDrawer);
    document.querySelectorAll('[data-drawer-close]').forEach(button => {
      button.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', event => {
      const drawerOpen = !infoDrawer.classList.contains('translate-y-full');
      if (drawerOpen) {
        if (event.key === 'Escape') closeDrawer();
        else trapFocus(event, infoDrawer);
        return;
      }
      if (panelOpen) {
        if (event.key === 'Escape') closePanel();
        else trapFocus(event, toolPanel);
      }
    });
  </script>
</body>
</html>
