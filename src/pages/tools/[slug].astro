---
import tools from '../../data/tools.json';

export function getStaticPaths() {
  return tools.map(tool => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
const homeUrl = '/prstk-lab/';
const canonicalUrl = `https://hanjhou2000716.github.io/prstk-lab/tools/${tool.slug}/`;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${tool.name}｜PRStK Lab`,
  description: tool.summary,
  url: canonicalUrl,
  isPartOf: { '@type': 'WebSite', name: 'PRStK Lab', url: homeUrl }
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; form-action 'self'; frame-src 'none'; upgrade-insecure-requests" />
    <title>{tool.name}｜PRStK Lab</title>
    <meta name="description" content={tool.summary} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="PRStK Lab" />
    <meta property="og:title" content={`${tool.name}｜PRStK Lab`} />
    <meta property="og:description" content={tool.summary} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="stylesheet" href="../../assets/styles.css" />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body class="min-h-screen bg-muji-bg text-muji-text font-sans">
    <a href="#tool-detail" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-muji-brand focus:px-4 focus:py-3 focus:text-sm focus:text-white">跳至工具詳情</a>
    <main id="tool-detail" class="mx-auto min-h-screen w-full max-w-3xl px-5 py-8 sm:px-8">
      <header class="flex items-center justify-between gap-4">
        <a href={homeUrl} class="text-sm font-medium tracking-[0.16em] text-muji-brand hover:text-orange">PRStK Lab</a>
        <a href={`${homeUrl}#tool-search-panel`} class="rounded-full border border-muji-border bg-white/80 px-4 py-2 text-xs text-muji-brand hover:border-muji-brand">回到工具入口</a>
      </header>

      <article class="mt-10 rounded-3xl border border-muji-border/80 bg-white/90 p-6 shadow-sm backdrop-blur-sm sm:p-9">
        <div class="flex flex-wrap items-center gap-2 text-xs text-muji-muted">
          {tool.categories.map(category => <span class="rounded-full bg-muji-brandLight px-3 py-1">{category}</span>)}
          <span class="rounded-full border border-muji-border px-3 py-1">{tool.status}</span>
        </div>
        <h1 class="mt-5 text-2xl font-semibold tracking-wide text-muji-text sm:text-3xl">{tool.name}</h1>
        <p class="mt-2 text-sm tracking-widest text-muji-brand">{tool.brandName}</p>
        <p class="mt-6 text-base leading-8 text-muji-text/85">{tool.summary}</p>

        <section class="mt-8 rounded-2xl border border-muji-border/60 bg-[#FCFAFC] p-5">
          <h2 class="flex items-center gap-2 text-sm font-semibold tracking-[0.15em] text-muji-brand">核心功能</h2>
          <ul class="mt-4 space-y-3 text-sm leading-7">
            {tool.features.map(feature => <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-muji-brand/60"></span><span>{feature}</span></li>)}
          </ul>
        </section>

        <section class="mt-5 rounded-2xl border border-muji-border/60 bg-[#FCFAFC] p-5">
          <h2 class="flex items-center gap-2 text-sm font-semibold tracking-[0.15em] text-muji-brand">適合對象</h2>
          <ul class="mt-4 space-y-3 text-sm leading-7">
            {tool.targetUsers.map(target => <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-muji-accent/80"></span><span>{target}</span></li>)}
          </ul>
        </section>

        <section class="mt-5 rounded-2xl border border-muji-border/60 p-5">
          <h2 class="text-sm font-semibold tracking-[0.15em] text-muji-brand">研究備註</h2>
          <p class="mt-3 text-sm leading-7 text-muji-muted">{tool.limitations.join(' ')}</p>
          <p class="mt-3 text-xs leading-6 text-muji-muted/80">{tool.riskNotice}</p>
          <p class="mt-3 text-xs text-muji-muted/70">最後驗證：{tool.lastVerifiedAt} · {tool.verifiedBy}</p>
        </section>

        <a href={tool.url} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="mt-8 flex items-center justify-center rounded-xl bg-muji-brand px-5 py-4 text-sm font-medium tracking-widest text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#384a54]">開啟 {tool.brandName}</a>
      </article>

      <footer class="py-8 text-center text-xs text-muji-muted/70">本頁資訊僅供研究參考，非投資建議。</footer>
    </main>
  </body>
</html>
