{
  "name": "prstk-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/assets/styles.css --minify",
    "build": "npm run build:css && npm run schema:validate && npm run cards:validate && npm run components:validate && npm run security:validate && npm run seo:validate && npm run research:validate && npm run research-library:validate && npm run workbench:validate && astro check && astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate-inline-js.cjs",
    "baseline:capture": "node scripts/capture-release-0-baseline.cjs",
    "baseline:validate": "node scripts/validate-release-0-baseline.cjs",
    "astro:check": "astro check",
    "build:validate": "node scripts/validate-astro-build.cjs",
    "data:generate": "node scripts/generate-tool-data.cjs",
    "schema:validate": "node scripts/validate-tool-schema.cjs",
    "cards:validate": "node scripts/validate-data-driven-cards.cjs",
    "components:validate": "node scripts/validate-components.cjs",
    "security:validate": "node scripts/validate-external-assets.cjs",
    "seo:validate": "node scripts/validate-seo.cjs",
    "research:validate": "node scripts/validate-research.cjs",
    "research-library:validate": "node scripts/validate-research-library.cjs",
    "workbench:validate": "node scripts/validate-workbench.cjs",
    "links:check": "node scripts/check-links.cjs --output=link-report.json",
    "test:unit": "node --test tests/tool-catalog.test.cjs",
    "test:smoke": "node --test tests/static-smoke.test.cjs",
    "performance:validate": "node scripts/validate-performance-budget.cjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/aos": "^3.0.8",
    "astro": "^7.1.6",
    "tailwindcss": "3.4.17",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "lucide": "^0.468.0"
  }
}
